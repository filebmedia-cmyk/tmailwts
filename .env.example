# ==========================================
# KONFIGURASI TMAIL (DOMAIN: oursastore.com)
# ==========================================

# 1. MongoDB Atlas Connection URI
# Teman Anda bisa buat cluster gratis di https://www.mongodb.com/atlas (Free M0 Cluster)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/tmail_db?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/tmail_db?retryWrites=true&w=majority"
MONGODB_DB="tmail_db"

# 2. Master Admin Key & Security
# Kunci rahasia untuk login ke panel admin (/admin) dan mengelola API key
MASTER_ADMIN_KEY="admin123"

# Secret key untuk enkripsi token sesi JWT admin (bisa string acak apa saja)
JWT_SECRET="tmail_jwt_secret_oursastore_bebas_diisi_acak_2026"

# 3. Webhook Secret Cloudflare
# Kunci pengaman antara Cloudflare Worker dan Webhook Vercel
# Nilai ini HARUS SAMA dengan variable WEBHOOK_SECRET di Cloudflare Worker
WEBHOOK_SECRET="tm_whsec_oursastore_secret_2026"

# 4. URL Website (OPSIONAL / TIDAK WAJIB DIISI)
# Aplikasi secara otomatis mendeteksi URL domain dari request browser & server (req.nextUrl.origin)
# Jadi baris ini TIDAK PERLU dimasukkan ke Vercel jika tidak ingin mengisinya.
# NEXT_PUBLIC_APP_URL="https://oursastore.com"
